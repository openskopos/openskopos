      "id": "FR3",
      "type": "requirement",
      "text": "The seat count never goes below zero, also while a plan change runs.",
      "status": "accepted",
      "priority": "should",
      "detail": "An invariant. A property-based test fits it."
    },
    {
      "id": "FR5",
      "type": "requirement",
      "text": "An admin can see the seat limit of each plan before a change.",
      "status": "accepted",
      "priority": "should",
