    {
      "id": "FR4",
      "type": "requirement",
      "text": "A plan change that leaves more seats in use than the new limit is blocked.",
      "status": "accepted",
      "priority": "must",
      "examples": [
        {
          "text": "12 seats in use, new limit 10. The change is blocked."
        }
      ],
      "refs": [
        {
          "item": "FR2",
          "rel": "supersedes"
        },
        {
          "item": "G2",
          "rel": "derived_from"
        }
      ]
    },
